
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Фото профилей и публикации пользователей
    match /profilePhotos/{userId}/{filePath=**} {

      // Авторизованные участники могут просматривать фотографии
      allow read: if request.auth != null
        && request.auth.uid.matches('tg_.*');

      // Загружать и обновлять фотографии может только владелец
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Удалять фотографии может только владелец
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
